# Exemplo futuro — NÃO usado no compose local.
# Reverse proxy de referência para deploy com domínio próprio.
# Uso local continua direto: web em :3000, api em :8000.

server {
    listen 80;
    server_name trama.local;

    # Frontend
    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # API
    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
