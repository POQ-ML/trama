# Copie para .env: cp .env.example .env
# ATENÇÃO: troque todos os valores marcados com CHANGE_ME antes de usar.
ENVIRONMENT=local

POSTGRES_USER=trama
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trama
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# pgAdmin 4 — painel de administração do banco (dev only, nunca expor em produção).
# Acesse em http://localhost:5050
PGADMIN_EMAIL=admin@trama.dev
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# Testes de integração (test_migrations_integration.py).
# Aponte para um banco descartável — nunca produção.
# TEST_DATABASE_URL=postgresql+psycopg2://trama:CHANGE_ME@localhost:5432/trama_test
