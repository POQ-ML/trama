# Copie para .env: cp .env.example .env
# ATENÇÃO: troque todos os valores marcados com CHANGE_ME antes de usar.
ENVIRONMENT=local

POSTGRES_USER=trama
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trama
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# pgAdmin 4 — painel de administração do banco (dev only, nunca expor em produção).
# Acesse em http://localhost:5050
PGADMIN_EMAIL=admin@trama.dev
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# Testes de integração (test_migrations_integration.py).
# Aponte para um banco descartável — nunca produção.
# TEST_DATABASE_URL=postgresql+psycopg2://trama:CHANGE_ME@localhost:5432/trama_test

# LLM (abstração provider-independent; Gemini Flash free tier nos testes).
# Modelo padrão verificado em 2026-10-13 (ai.google.dev/gemini-api/docs/models):
# gemini-3.5-flash-lite (rápido/custo zero nos testes). Alternativa documentada:
# gemini-3.8-flash. Qualquer endpoint Flash estável pode ir em LLM_MODEL.
# Nunca commitar chave real; só via ambiente local não versionado.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TELEMETRY_ENABLED=true
# Smoke test ao vivo (opt-in, pulado por padrão): export TRAMA_LLM_LIVE_TEST=1
# com GEMINI_API_KEY válida e dados apenas sintéticos/próprios (free tier usa
# o conteúdo para melhoria — nunca dados de terceiros; ver ADR-0005/REQ-0021).

# ---------------------------------------------------------------------------
# Ingestão — OpenAlex
# ---------------------------------------------------------------------------
# OPENALEX_API_KEY: opcional. Obtém em https://openalex.org/settings/api
#   (conta gratuita, $1/dia). Sem chave: 10 req/s, paginação básica (≤10 000).
#   Com chave: 30 req/s, cursor paging sem limite.
#   Sem chave o conector funciona com aviso em log.
OPENALEX_API_KEY=

# OPENALEX_EMAIL: opcional, mas recomendado. Endereço de contato para o
#   "polite pool" da OpenAlex. Usado como ?mailto= nas requisições.
#   Exemplo fictício: seu_email@exemplo.com
OPENALEX_EMAIL=

# ---------------------------------------------------------------------------
# Ingestão — GitHub
# ---------------------------------------------------------------------------
# GITHUB_TOKEN: opcional. Personal Access Token (classic) com escopo public_repo
#   (somente leitura de repos públicos). Sem token: 60 req/h. Com token: 5 000 req/h.
#   Obter em: https://github.com/settings/tokens
#   Sem token o conector funciona com aviso em log.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Testes de integração (ingestão)
# ---------------------------------------------------------------------------
# TRAMA_INGESTION_LIVE_TEST=1 habilita testes de integração que fazem
# requisições reais às APIs (opt-in, nunca roda por padrão na suíte).
# Requer as credenciais acima configuradas.
# TRAMA_INGESTION_LIVE_TEST=
